{
  "name": "vite-plugin-carbon8r",
  "version": "0.1.3",
  "description": "Option/Alt-click any element in the browser to open its source in your editor. Works with React 19 (no reliance on _debugSource).",
  "license": "MIT",
  "author": "Roberto Carboni <robcarbon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carboni-rob/carbon8r.git",
    "directory": "packages/vite-plugin-carbon8r"
  },
  "homepage": "https://github.com/carboni-rob/carbon8r#readme",
  "bugs": "https://github.com/carboni-rob/carbon8r/issues",
  "keywords": [
    "vite-plugin",
    "react",
    "react-19",
    "jump-to-source",
    "click-to-source",
    "open-in-editor",
    "devtools",
    "dx"
  ],
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "runtime",
    "LICENSE"
  ],
  "peerDependencies": {
    "vite": ">=5"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "launch-editor": "^2.14.1",
    "magic-string": "^1.2.0"
  }
}
